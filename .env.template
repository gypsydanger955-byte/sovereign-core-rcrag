# RCRAG Service Environment Configuration

# Application
APP_NAME=rcrag-service
APP_ENV=production
LOG_LEVEL=INFO

# Historian Database (PostgreSQL)
HISTORIAN_DB_HOST=localhost
HISTORIAN_DB_PORT=5432
HISTORIAN_DB_NAME=historian
HISTORIAN_DB_USER=historian_user
HISTORIAN_DB_PASSWORD=change_me_in_production

# Neo4j (if using graph database)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me_in_production

# Observability
PROMETHEUS_ENABLED=true
TRACING_ENABLED=true
OTEL_SERVICE_NAME=rcrag-service
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Cache Configuration
CACHE_TTL_SECONDS=30
CACHE_MAX_ENTRIES=1024

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST_CAPACITY=10

# Circuit Breaker
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT_SECONDS=60
CIRCUIT_BREAKER_HALF_OPEN_MAX_CALLS=3
